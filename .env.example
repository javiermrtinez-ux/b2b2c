# Copia este archivo a .env y rellena los valores. NO subir .env a git.
# Los nombres llevan el prefijo NUXT_ porque es lo único que Nuxt lee al arrancar el servidor compilado
# (los valores se leen en tiempo de ejecución, no se meten en el build).

# Tradedoubler (PVN API)
NUXT_TD_CLIENT_ID=
NUXT_TD_CLIENT_SECRET=
# Usuario y contraseña de Tradedoubler: solo para el primer token (grant_type=password)
# o si el refresh token guardado caduca. Si los dejas vacíos, hace falta NUXT_TD_REFRESH_TOKEN.
NUXT_TD_USERNAME=
NUXT_TD_PASSWORD=
# Opcional: si ya tienes un refresh token vigente (se usa una sola vez y luego se guarda en la base de datos)
NUXT_TD_REFRESH_TOKEN=
# Fuentes a sincronizar, separadas por comas. Vacío = todas las fuentes de la red.
NUXT_TD_SOURCE_ID=
# Opcionales, separados por comas
NUXT_TD_PROGRAM_ID=
NUXT_TD_EVENT_TYPE_IDS=
# Desde cuándo sincronizar la primera vez (YYYY-MM-DD)
NUXT_TD_SYNC_FROM=2025-01-01
# Días que cada sincronización vuelve a revisar para recoger validaciones/anulaciones tardías
NUXT_TD_LOOKBACK_DAYS=90

# Renovaciones
NUXT_RENEWAL_DAYS=365
# mock = datos simulados; cambia a "real" cuando exista el adaptador del partner
NUXT_PARTNER_MODE=mock
NUXT_PARTNER_URL=
NUXT_PARTNER_KEY=

# Protege el panel y la API con este token (cabecera x-admin-token). Obligatorio fuera de desarrollo.
NUXT_ADMIN_TOKEN=

# Opcional: ruta de la base de datos (por defecto data/ventas.sqlite)
DB_PATH=
